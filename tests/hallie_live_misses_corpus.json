{
  "schemaVersion": 1,
  "corpusID": "hallie-live-misses-v1",
  "description": "Live Hallie misses pinned as a second, growing lane. Same schema as hallie_interaction_corpus.json so scripts/hallie_eval.py run --corpus tests/hallie_live_misses_corpus.json works unchanged; the fixed 200-turn corpus and its sensors are left alone.",
  "categories": [
    {
      "id": "family_tree_live",
      "expectedRoutes": [
        "graph",
        "follow-up"
      ],
      "expectedOutcomes": [
        "answered",
        "declined",
        "needsClarification"
      ],
      "noFabricatedPersonalMemory": true,
      "forbidRawInternals": true,
      "mustNotContain": [
        "tap Get Family Tree, choose how many ancestor steps"
      ],
      "prompts": [
        {
          "text": "Can we trace the Hudson line from Donna or did we only get the GEDCOM for Rick?",
          "note": "2026-08-27 22:07Z, asked twice; routed to the Get Family Tree download pitch. Fixed on fix/hallie-gedcom-provenance-question."
        },
        {
          "text": "How are Rick and Donna related?",
          "note": "2026-08-27 two-root merge: deterministic .commonAncestor shape; nearest shared ancestor + cousin term, or the honest 'Donna's side isn't in the tree yet'."
        },
        {
          "text": "What is the common ancestor of Rick and Donna?",
          "note": "2026-08-27 .commonAncestor shape."
        },
        {
          "text": "Are Rick and Donna related?",
          "note": "2026-08-27 .commonAncestor shape."
        },
        {
          "text": "What do Rick and Donna have in common ancestrally?",
          "note": "2026-08-27 .commonAncestor shape."
        }
      ]
    },
    {
      "id": "family_tree_2026_08_29",
      "expectedRoutes": [
        "graph"
      ],
      "expectedOutcomes": [
        "answered",
        "declined",
        "needsClarification"
      ],
      "noFabricatedPersonalMemory": true,
      "forbidRawInternals": true,
      "prompts": [
        {
          "id": "miss-02-owner-binding",
          "text": "Can you find the closest common ancestor between me (Rick) and Donna?",
          "expectedOutcome": "answered",
          "mustContain": [
            "Richard Harding Breen Jr",
            "Donna Hudson"
          ],
          "mustMatch": [
            "\\b(?:common ancestor|nearest|share(?:s|d)?\\s+\\d+\\s+recorded ancestors?)\\b"
          ],
          "mustNotMatch": [
            "\\b(?:no|not|never|can't|cannot|couldn't|don't|do not|didn't|did not)\\b[^.!?]{0,80}\\b(?:common ancestor|share|related)\\b"
          ],
          "mustNotContain": [
            "Which Rick",
            "Catherine Auker",
            "Robert de Cralle",
            "catalog items matching"
          ],
          "note": "Miss #2: bind me (Rick) to the configured owner before any bare-name search; never offer medieval non-Richards."
        },
        {
          "id": "miss-06-center-spelling-recovery",
          "text": "can you center on marhta lamson",
          "expectedOutcome": "answered",
          "mustContain": [
            "Marhta Lamson",
            "Martha Lamson"
          ],
          "mustMatch": [
            "\\b(?:center|centering)\\b",
            "\\b(?:took|taking)\\b[^.!?]{0,80}\\bmean\\b"
          ],
          "mustNotMatch": [
            "\\b(?:cannot|can't|couldn't|won't|will not|not able|unable)\\b[^.!?]{0,80}\\b(?:center|focus|open)\\b"
          ],
          "mustNotContain": [
            "catalog items matching"
          ],
          "note": "Miss #6: deterministic Family Tree navigation with stated spelling recovery, never a catalog search."
        },
        {
          "id": "miss-07-complete-biography-card",
          "text": "tell me about Matthew Rice",
          "expectedOutcome": "answered",
          "mustContain": [
            "Martha Lamson"
          ],
          "mustMatch": [
            "\\b(?:child(?:ren)?|sons?|daughters?)\\b[^.!?]{0,120}\\b(?:Isaac Rice|Patience Rice)\\b|\\b(?:Isaac Rice|Patience Rice)\\b[^.!?]{0,120}\\b(?:child(?:ren)?|sons?|daughters?)\\b",
            "\\b(?:ancestors?|grandparents?)\\b"
          ],
          "note": "Miss #7: biography and family-tree asks share the complete fact card rather than dropping places, marriage, children, or depth."
        },
        {
          "id": "miss-10-fragment-guard",
          "text": "tell me about Muriel Lamb",
          "expectedOutcome": "answered",
          "mustContain": [
            "Muriel Lamb",
            "Edith Lucy Parker",
            "Frederick Burton Lamb",
            "George Breen",
            "Richard Harding Breen Sr"
          ],
          "mustMatch": [
            "\\b(?:child|daughter)\\b[^.!?]{0,240}\\b(?:grandparents?|Clarissa Horton Schoolcraft)\\b",
            "\\b(?:married|husband|spouse)\\b[^.!?]{0,120}\\bGeorge Breen\\b|\\bGeorge Breen\\b[^.!?]{0,120}\\b(?:married|husband|spouse)\\b"
          ],
          "mustNotMatch": [
            "\\b(?:not|never|wasn't|was not|didn't|did not)\\b[^.!?]{0,60}\\b(?:married|marry|spouse|wife|husband)\\b"
          ],
          "mustNotContain": [
            ". ,"
          ],
          "note": "Miss #10: a model-split claim must be dropped and restored as a complete sentence, never the observed '. ,' fragment."
        },
        {
          "id": "miss-11-surname-roster",
          "text": "tell me about pa oc'connor",
          "mustContain": [
            "O'Connor"
          ],
          "mustNotContain": [
            "try a fuller name"
          ],
          "note": "Miss #11: recover O'Connor and offer its roster, or resolve a real Pa alias; never reinterpret it as a catalog term."
        },
        {
          "id": "miss-16-cross-world-card",
          "text": "tell me about rick's family tree, his brothers, sisters, parents, and grandparents",
          "expectedOutcome": "answered",
          "mustContain": [
            "G89Q-34N",
            "GNZ5-428"
          ],
          "mustMatch": [
            "\\bPeople[- ]tab\\b",
            "\\bTim\\b[^.!?]{0,120}\\b(?:brother|sibling)\\b|\\b(?:brother|sibling)\\b[^.!?]{0,120}\\bTim\\b",
            "\\b(?:duplicate|same[- ]person|merge|merging)\\b"
          ],
          "note": "Miss #16: one cross-world card includes People-tab kin and flags the duplicate-parent condition with tree IDs."
        },
        {
          "id": "miss-19-kinship-word-property",
          "text": "what is Dad's name and his birthdate?",
          "mustNotContain": [
            "can't trace father for Dad"
          ],
          "note": "Miss #19: possessive Dad is a property ask about the Dad profile, not father-of-Dad. A missing pin may still require clarification."
        }
      ]
    },
    {
      "id": "which_one_and_repair_2026_08_29",
      "noFabricatedPersonalMemory": true,
      "forbidRawInternals": true,
      "sessions": [
        {
          "id": "miss-03-year-selection",
          "turns": [
            {
              "text": "tell me about Nathaniel Parker",
              "expectedRoutes": [
                "graph"
              ],
              "expectedOutcome": "needsClarification",
              "mustContain": [
                "Nathaniel Parker Sr",
                "Nathaniel Caleb Parker"
              ],
              "note": "Establish the stable Nathaniel Parker namesake clarification; it does not disappear when a contemporary profile gains a GEDCOM pin."
            },
            {
              "text": "the one born in 1651",
              "expectedRoutes": [
                "follow-up"
              ],
              "expectedOutcome": "answered",
              "mustContain": [
                "Nathaniel Parker Sr"
              ],
              "note": "Miss #3: select the unique birth-year candidate and resume the original biography ask."
            }
          ]
        },
        {
          "id": "miss-04-conversation-repair",
          "turns": [
            {
              "text": "tell me about Nathaniel Parker",
              "expectedRoutes": [
                "graph"
              ],
              "expectedOutcome": "needsClarification",
              "mustContain": [
                "Nathaniel Parker Sr",
                "Nathaniel Caleb Parker"
              ],
              "note": "Establish a deterministic pending which-one list."
            },
            {
              "text": "you presented me a list of people born hundreds or years ago",
              "expectedRoutes": [
                "follow-up"
              ],
              "expectedOutcome": "repaired",
              "mustContain": [
                "You asked “tell me about Nathaniel Parker”",
                "Everyone I offered was born centuries ago",
                "Give me the full name, or a birth year"
              ],
              "mustNotContain": [
                "catalog items matching"
              ],
              "note": "Miss #4: acknowledge and repair the pending ask; never run a catalog search for the complaint."
            }
          ]
        }
      ]
    },
    {
      "id": "conversation_focus_2026_08_29",
      "noFabricatedPersonalMemory": true,
      "forbidRawInternals": true,
      "sessions": [
        {
          "id": "miss-09-our-common-ancestor",
          "turns": [
            {
              "text": "tell me about Martha Lamson",
              "expectedRoutes": [
                "graph"
              ],
              "expectedOutcome": "answered",
              "mustContain": [
                "Martha Lamson"
              ],
              "note": "Establish Martha Lamson as the explicit conversation focus."
            },
            {
              "text": "find our nearest common ancestor",
              "expectedRoutes": [
                "graph"
              ],
              "expectedOutcomes": [
                "answered",
                "declined"
              ],
              "mustContain": [
                "Martha Lamson"
              ],
              "mustNotContain": [
                "Donna Hudson"
              ],
              "note": "Miss #9: our means owner plus the explicit conversation focus; Martha must win over the owner's spouse regardless of whether the tree finds a shared ancestor."
            }
          ]
        }
      ]
    },
    {
      "id": "people_kinship_2026_08_29",
      "expectedRoutes": [
        "capability"
      ],
      "expectedOutcome": "answered",
      "noFabricatedPersonalMemory": true,
      "forbidRawInternals": true,
      "prompts": [
        {
          "id": "miss-12-relationships-overview",
          "text": "tell me how rick is related to the people in the people tab who currently living or recently deceased",
          "mustMatch": [
            "\\b(?:related|relationships?|relatives?|kinship)\\b",
            "\\b(?:nearest|closest|immediate|starting with)\\b"
          ],
          "note": "Miss #12: answer the relationships overview from the kinship engine ahead of the ordinary People-tab roster."
        }
      ]
    },
    {
      "id": "pronunciation_2026_08_29",
      "expectedRoutes": [
        "telling"
      ],
      "expectedOutcome": "answered",
      "noFabricatedPersonalMemory": true,
      "forbidRawInternals": true,
      "prompts": [
        {
          "id": "miss-14-pronunciation-hint",
          "text": "Latta should be pronounced with a short a on the La",
          "mustContain": [
            "Latta",
            "LAT-uh",
            "short a"
          ],
          "mustMatch": [
