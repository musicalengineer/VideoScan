          ],
          "note": "Miss #17: typo-tolerant free-form teach with alternatives; uncertain detail is retained rather than declined or searched."
        },
        {
          "id": "miss-18-pronunciation-precedence",
          "text": "the family name \"Latta\" should be pronounced with a short a, like in Ladder, but it would be \"Latt uh\"",
          "mustContain": [
            "Latta",
            "LAT-uh",
            "short a"
          ],
          "mustMatch": [
            "\\b(?:noted|say|pronounce)\\b"
          ],
          "mustNotMatch": [
            "\\b(?:(?:did|do|will) not|didn't|don't|won't|cannot|can't)\\s+(?:keep|say|pronounce)\\b"
          ],
          "mustNotContain": [
