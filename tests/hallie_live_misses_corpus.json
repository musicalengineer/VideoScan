          ],
          "mustMatch": [
            "\\bI say Latta as\\b|\\bLatta\\b[^.!?]{0,100}\\bpronounc(?:e|ed|iation)\\b"
          ],
          "mustNotMatch": [
            "\\b(?:(?:did|do|will) not|didn't|don't|won't|cannot|can't)\\s+(?:keep|say|pronounce)\\b"
          ],
          "mustNotContain": [
            "catalog items matching"
          ],
          "note": "Miss #15: typo-tolerant pronunciation query, answered from the voice lexicon and drill sheet."
        },
        {
          "id": "miss-17-freeform-pronunciation",
