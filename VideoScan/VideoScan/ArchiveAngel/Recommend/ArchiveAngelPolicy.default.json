{
  "floors" : [
    {
      "id" : "notVideo",
      "kind" : "notVideo",
      "note" : "Audio-only files, stills and un-probed files are not videos"
    },
    {
      "id" : "onMasterArchive",
      "kind" : "onMasterArchive",
      "note" : "The file is in the Master Archive or already has its copy there"
    },
    {
      "id" : "fileGone",
      "kind" : "match",
      "note" : "Relocate marked the file deleted or unsalvageable",
      "rejection" : "fileGone",
      "when" : [
        {
          "field" : "archiveStage",
          "op" : "in",
          "value" : [
            "manuallyDeleted",
            "salvageFailed"
          ]
        }
      ]
    },
    {
      "id" : "archivedCopy",
      "kind" : "archivedCopy",
      "note" : "A copy of it, or the original this is a version of, is already archived"
    },
    {
      "id" : "extraCopy",
      "kind" : "match",
      "note" : "You marked it an Extra copy — the Keep copy is the one to archive",
      "rejection" : "extraCopy",
      "when" : [
        {
          "field" : "duplicateDisposition",
          "op" : "==",
          "value" : "extraCopy"
        }
      ]
    },
    {
      "id" : "notPlayable",
      "kind" : "notPlayable"
    },
    {
      "id" : "pairedHalf",
      "kind" : "pairedHalf",
      "note" : "Combine the A/V pair first; the combined file is the candidate"
    },
    {
      "explicitPicks" : false,
      "id" : "livePhotoMotion",
      "kind" : "livePhotoMotion",
      "note" : "Rick 2026-09-21: a Live Photo's motion half is part of a photo"
    },
    {
      "explicitPicks" : false,
      "id" : "recentPhoneClip",
      "kind" : "recentPhoneClip",
      "note" : "Rick 2026-09-21: only phone clips older than weights.recentPhoneClipYears"
    },
    {
      "id" : "appCache",
      "kind" : "appCache",
      "starExempt" : true
    },
    {
      "id" : "derivativeOfOriginal",
      "kind" : "derivativeOfOriginal",
      "starExempt" : true
    },
    {
      "id" : "tooShort",
      "kind" : "tooShort",
      "note" : "weights.minimumDurationSeconds (explicit picks: explicitPickMinimumDurationSeconds)"
    },
    {
      "id" : "proxyStream",
      "kind" : "proxyStream",
      "starExempt" : true
    },
    {
      "id" : "markedJunk",
      "kind" : "markedJunk"
    },
    {
      "id" : "suspectedJunk",
      "kind" : "suspectedJunk",
      "starExempt" : true
    },
    {
      "id" : "junkScore",
      "kind" : "junkScore",
      "note" : "weights.junkFloor",
      "starExempt" : true
    },
    {
      "id" : "volumeOffline",
      "kind" : "volumeOffline"
    },
    {
      "id" : "resting",
      "kind" : "resting",
      "note" : "Attention memory: passed on three times, back after weights.restDays"
    }
  ],
  "grades" : {
    "a" : 100,
    "b" : 60,
    "c" : 25,
    "d" : 1
  },
  "name" : "default",
  "recommend" : {
    "classes" : [
      {
        "class" : "ready",
        "when" : [
          {
            "any" : [
              {
                "field" : "vouched",
                "op" : "==",
                "value" : true
              },
              {
                "field" : "grade",
                "op" : "==",
                "value" : "A"
              }
            ]
          },
          {
            "field" : "dated",
            "op" : "==",
            "value" : true
          }
        ]
      },
      {
        "class" : "needsDate",
        "when" : [
          {
            "any" : [
              {
                "field" : "vouched",
                "op" : "==",
                "value" : true
              },
              {
                "field" : "grade",
                "op" : "==",
                "value" : "A"
              }
            ]
          }
        ]
      },
      {
        "class" : "worthALook",
        "when" : [
          {
            "field" : "grade",
            "op" : "==",
            "value" : "B"
          }
        ]
      }
    ],
    "copies" : {
      "classes" : [
        "ready",
        "needsDate",
        "worthALook"
      ],
      "collapseBy" : [
        "duplicateGroup",
        "nameAndDuration"
      ],
      "noteCopies" : true,
      "prefer" : [
        "userKeeper",
        "best"
      ]
    },
    "date" : {
      "minimum" : "year"
    },
    "exclude" : [

    ],
    "order" : "angelRank",
    "prepare" : [
      "ready",
      "worthALook"
    ],
    "useAngelFloors" : true,
    "vouch" : [
      {
        "id" : "important",
        "kind" : "match",
        "line" : "marked Important",
        "points" : 3,
        "when" : [
          {
            "field" : "mediaDisposition",
            "op" : "==",
            "value" : "important"
          }
        ]
      },
      {
        "id" : "stars",
        "kind" : "stars",
        "points" : 1,
        "when" : [
          {
            "field" : "starRating",
            "op" : ">=",
            "value" : 2
          }
        ]
      },
      {
        "id" : "stageReady",
        "kind" : "match",
        "line" : "stage: Ready",
        "points" : 2,
        "when" : [
          {
            "field" : "archiveStage",
            "op" : "==",
            "value" : "readyForArchive"
          }
        ]
      },
      {
        "id" : "stageMaster",
        "kind" : "match",
        "line" : "stage: Master",
        "points" : 1,
        "when" : [
          {
            "field" : "archiveStage",
            "op" : "==",
            "value" : "masterAssigned"
          }
        ]
      },
      {
        "id" : "keeper",
        "kind" : "match",
        "line" : "the copy to keep",
        "vouches" : false,
        "when" : [
          {
            "field" : "duplicateDisposition",
            "op" : "==",
            "value" : "keep"
          }
        ]
      }
    ]
  },
