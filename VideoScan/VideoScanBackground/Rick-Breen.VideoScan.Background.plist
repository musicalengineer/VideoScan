<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- launchd agent for VideoScan Background (docs/design/background_service_2026_10_30.md §3.2).
	     Copied by the app target into VideoScan.app/Contents/Library/LaunchAgents/ and registered
	     with SMAppService.agent(plistName:). BundleProgram is relative to the app bundle. -->
	<key>Label</key>
	<string>Rick-Breen.VideoScan.Background</string>
	<key>BundleProgram</key>
	<string>Contents/Library/LoginItems/VideoScan Background.app/Contents/MacOS/VideoScan Background</string>
	<key>MachServices</key>
	<dict>
		<key>Rick-Breen.VideoScan.Background</key>
		<true/>
	</dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>Nice</key>
	<integer>10</integer>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>Rick-Breen.VideoScan</string>
	</array>
</dict>
</plist>
