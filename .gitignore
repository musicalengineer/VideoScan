# Python
venv/
venv-mlx/
venv-genealogy/
__pycache__/
*.pyc
*.pyo

# Scratch / experiments — asm benchmarks, perf one-offs, throwaway code
experiments/

# Xcode / Swift
build/
.deriveddata/
.derivedData*/
DerivedData/
*.xcuserstate
xcuserdata/

# SwiftPM build artifacts (local VideoScanCore package)
.build/
.swiftpm/

# macOS
.DS_Store
*.swp

# Generated outputs
*.xlsx
*.csv
*.zip

# Diagnostic / scratch
d.txt
DonnaFaceDetectionTest.png

# Claude Code
.claude/settings.local.json
.claude/worktrees/

# ML models (too large for git, downloaded separately).
# Anchored to repo root so it ONLY ignores the top-level ./models weights
# dir — NOT app source folders named Models/ (git's core.ignorecase on
# macOS makes an unanchored `models/` also match `VideoScan/.../Models/`).
/models/

# Test media — allow small generated fixtures, block private real media
# The pre-commit hook also rejects any staged file > 75 MB
tests/fixtures/videos/*
!tests/fixtures/videos/test_*

# Local-only external media corpus. Keep the documentation and example
# manifest in git; keep real videos/audio local.
VideoScan/VideoScanTests/Fixtures/External/*
!VideoScan/VideoScanTests/Fixtures/External/README.md
!VideoScan/VideoScanTests/Fixtures/External/manifest.example.json

# Local dashboard cache — populated by scripts/dashboard.sh from
# the `metrics` branch. Never commit; it's a local snapshot.
docs/history.jsonl

# Xcode test result bundles — generated by `xcodebuild ... test
# -resultBundlePath`. Opaque content-addressed blobs, not source.
*.xcresult/

# Build / lint / CI scratch output — all regeneratable
/xcodebuild-test.log
/periphery-raw.txt
/swiftlint-raw.txt
/docs/metrics-report.html

# Generated face-recognition outputs (embeddings, scan CSVs, plots)
/output/

# POI data now lives in ~/Library/Application Support/VideoScan/POI/
# (issue #35). Any lingering legacy copies in the repo are local state.
/poi_profiles/
/poi_photos/

# Personal / scratch files that end up in the repo root
/ricksnotes.txt
/recover_timmy.mov

# Safety-swap destination for the .videoscanbundle importer and the
# "Delete person" UI. Contains real archived POI data the user may
# want to recover. Never commit.
/.trash/
.dd-gauntlet/
tests/fixtures/perf/
*.local.md
.cache/
# Personal media that must NEVER enter git, even now that the repo is
# private (Rick 2026-08-02): the era-banded reference galleries and the
# labeled family-video corpora live on disk only.
tests/fixtures/photos/Donna/
tests/fixtures/videos/DonnaTestVideos/
tests/fixtures/videos/*.mov
!tests/fixtures/videos/test_*.mov
# Post-vault policy (2026-08-03, go-public prep): plaintext personal
# photos live ONLY in the working tree, restored via tools/media-vault.
tests/fixtures/photos/*.jpg
tests/fixtures/photos/*.jpeg
tests/fixtures/photos/*.png
tests/fixtures/photos/*.tif
assets/app_photos/
# Vault blobs are LOCAL backup artifacts — never committed (2026-08-03).
vault/

# Rick's family photos staged for the archivist portrait / promotion — NEVER in git (privacy rule)
/photos/

# Personal media never in git (8/03 privacy scrub) — Hallie portraits live on disk only
assets/Hallie/
assets/hallie/

# Per-worktree DerivedData (agents build with -derivedDataPath <worktree>/.build-dd)
.build-dd/
