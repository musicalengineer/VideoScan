{
  "description": "Inject newly addressed local manager messages at the next user turn.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/rickb/dev/VideoScan/.claude/scripts/session_morning_hook.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/tools/team-channel.py\" hook --agent auto --format codex",
            "timeout": 3,
            "statusMessage": "Checking the local team channel"
          }
        ]
      }
    ]
  }
}
