#!/bin/bash
# Pre-commit hook:
#   1. Reject files larger than 75 MB (under GitHub's 100 MB hard limit).
#   2. Run SwiftLint on staged .swift files — warn only, does NOT block commit.
#      To escalate to blocking on violations, set SWIFTLINT_STRICT=1 in env.
#      (Its complexity/length ERROR thresholds never blocked anything because
#      of the `|| true` below — GH #281. Step 4 is what blocks them now.)
#   3. @EnvironmentObject usage linter (blocking).
#   4. Complexity gate on staged .swift/.py (blocking): a function over
#      CCN 30 / 300 lines that is new or worse than the committed baseline,
#      or a new swiftlint:disable of a size/complexity rule.
#      Escape hatch, recorded and reported nightly:
#        COMPLEXITY_OVERRIDE="reason" git commit ...
#
# To commit without running any of this: git commit --no-verify

MAX_SIZE=$((75 * 1024 * 1024))

status=0

# --- File-size gate (hard block) ---
while IFS= read -r -d '' file; do
    size=$(wc -c < "$file" 2>/dev/null | tr -d ' ')
    if [ -n "$size" ] && [ "$size" -gt "$MAX_SIZE" ]; then
        echo "BLOCKED: $(du -h "$file" | cut -f1)  $file  (limit: 75 MB)"
        status=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACM -z)

if [ "$status" -ne 0 ]; then
    echo ""
    echo "To commit anyway: git commit --no-verify"
    echo "Consider adding large files to .gitignore"
    exit 1
fi

# --- SwiftLint on staged Swift files (warn-only) ---
if command -v swiftlint >/dev/null 2>&1; then
    # Collect staged .swift paths (added/copied/modified) as a null-separated list.
    staged_swift=$(git diff --cached --name-only --diff-filter=ACM -z -- '*.swift' | tr '\0' '\n' | grep -v '^$' || true)
    if [ -n "$staged_swift" ]; then
        echo "swiftlint: checking $(echo "$staged_swift" | wc -l | tr -d ' ') staged Swift file(s)…"
        # --use-script-input-files reads paths from SCRIPT_INPUT_FILE_N env vars.
        count=0
        export SCRIPT_INPUT_FILE_COUNT=$(echo "$staged_swift" | wc -l | tr -d ' ')
        while IFS= read -r f; do
            export "SCRIPT_INPUT_FILE_$count=$PWD/$f"
            count=$((count + 1))
        done <<< "$staged_swift"

        if [ "${SWIFTLINT_STRICT:-0}" = "1" ]; then
            swiftlint lint --use-script-input-files --strict || exit 1
        else
            swiftlint lint --use-script-input-files --quiet || true
        fi
    fi
else
    echo "swiftlint: not installed — skipping lint (install: brew install swiftlint)"
fi

# --- Custom @EnvironmentObject usage linter (blocking) ---
# Catches the PersonFinderView-cascade antipattern: a view declares
# @EnvironmentObject var X but never reads X.prop in the body. The
# subscription retriggers body re-eval on every @Published change to
# the model for no purpose. See project_bug_prevention_strategy memory.
#
# The linter is fast (<1s on the full codebase). Runs on EVERY commit
# regardless of which files are staged so a config change can't sneak
# in a new violation. Annotate intentional forwarding with
#   // swiftlint:disable-next-line vs-env-object-unused
if command -v python3 >/dev/null 2>&1 \
        && [ -f "$PWD/scripts/lint_environment_objects.py" ]; then
    python3 scripts/lint_environment_objects.py || {
        echo ""
        echo "@EnvironmentObject usage check failed. See project_bug_prevention_strategy memory."
        echo "Either drop the unused declaration or annotate it intentional."
        echo "To commit anyway: git commit --no-verify"
        exit 1
    }
fi

# --- Complexity gate on staged files (blocking, GH #281) ---
# Needs lizard: prefer the repo's venv (shared by every worktree of this
# clone), then whatever python3 is on PATH. Fails closed with an install hint
# if neither has lizard — a gate that silently skips is how #281 happened.
if [ -f "$PWD/scripts/complexity_gate.py" ]; then
    common_dir=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
    gate_py=python3
    if [ -n "$common_dir" ] && [ -x "$(dirname "$common_dir")/venv/bin/python3" ]; then
        gate_py="$(dirname "$common_dir")/venv/bin/python3"
    fi
    "$gate_py" scripts/complexity_gate.py --staged || {
        echo ""
        echo "Commit blocked by the complexity gate (scripts/complexity_gate.py)."
        exit 1
    }
fi

# --- Gauntlet manifest drift (blocking) ---
# A NEW test file must be assigned a gauntlet stage in the same commit.
# 2026-10-06: 103 unassigned files blocked every gauntlet stage and nothing
# said so at commit time. Pure Python, checks only files ADDED in the index
# (milliseconds). The full validator remains scripts/gauntlet/inventory.swift.
if command -v python3 >/dev/null 2>&1 \
        && [ -f "$PWD/scripts/gauntlet/manifest_drift.py" ]; then
    python3 scripts/gauntlet/manifest_drift.py --staged || {
        echo ""
        echo "Commit blocked: new test file(s) without a gauntlet stage (see above)."
        exit 1
    }
fi

exit 0
