#!/bin/bash
# pre-merge-commit — a merge commit gets the same checks as an ordinary commit
# (complexity gate, gauntlet manifest drift, SwiftLint, the custom linters).
# Git skips pre-commit for merge commits, which let two branches' new test files
# reach main without a gauntlet stage on 2026-10-06/07. Rick: merges must not
# be a back door.
exec "$(git rev-parse --git-path hooks)/pre-commit" "$@"
